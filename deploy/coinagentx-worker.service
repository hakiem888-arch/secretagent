[Unit]
Description=CoinAgentX v6.0.5 Independent 24/7 Predictive Watchlist & Hybrid Adaptive Worker (PAPER ONLY)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/coinagentx
EnvironmentFile=/opt/coinagentx/.env
Environment=PYTHONUNBUFFERED=1
Environment=COINAGENT_REQUIRE_POSTGRES=1
ExecStart=/usr/bin/python3 /opt/coinagentx/worker.py --interval 60 --monitor-interval 10 --heartbeat-interval 30 --candidates 20 --shortlist-limit 50 --max-groq-candidates 5
Restart=always
RestartSec=10
MemoryMax=768M

[Install]
WantedBy=multi-user.target
